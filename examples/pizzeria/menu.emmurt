<cristian lengua="it">
  <capa>
    <inciucc nomme="viewport" cuntenuto="width=device-width, initial-scale=1">
    <titulo>Menù · 'A Pizzeria 'e Gennaro</titulo>
    <attacca rapporto="icona" addo="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍕</text></svg>">
    <attacca rapporto="stile" addo="/stile.css">
  </capa>
  <panz>
    <chiamm da="pezzi/cappiell.emmurt" />
    <core>
      <luccolone>'O menù</luccolone>
      <tavulat classe="menu">
        <capotavula>
          <fila><capocasella>Pizza</capocasella><capocasella>Prezzo</capocasella><capocasella></capocasella></fila>
        </capotavula>
        <cuorpotavula>
          <fila>
            <casella>Margherita</casella><casella>5 €</casella>
            <casella><citofono tipo="buttone" data-pizza="Margherita">Miettela int'o carrello</citofono></casella>
          </fila>
          <fila>
            <casella>Marinara</casella><casella>4 €</casella>
            <casella><citofono tipo="buttone" data-pizza="Marinara">Miettela int'o carrello</citofono></casella>
          </fila>
          <fila>
            <casella>Diavola</casella><casella>6,50 €</casella>
            <casella><citofono tipo="buttone" data-pizza="Diavola">Miettela int'o carrello</citofono></casella>
          </fila>
        </cuorpotavula>
      </tavulat>

      <luccolo>Ordina</luccolo>
      <modulo chi="ordine">
        <targhett pe="nomme">Comme te chiamme?</targhett>
        <miett chi="nomme" nomme="nomme" tipo="testo" esempio="Gennaro" poffozza>
        <targhett pe="telefono">Telefono</targhett>
        <miett chi="telefono" nomme="telefono" tipo="telefono" esempio="081 …" poffozza>
        <recinto>
          <leggenda>Comme 'a vuò?</leggenda>
          <targhett><miett tipo="pallino" nomme="consegna" valore="casa" spuntato> A casa</targhett>
          <targhett><miett tipo="pallino" nomme="consegna" valore="banco"> 'A vengo a piglià</targhett>
        </recinto>
        <targhett pe="note">Note pe' 'o pizzaiuolo</targhett>
        <ragionamento chi="note" nomme="note" righe="3"></ragionamento>
        <citofono tipo="manna">Manna l'ordine</citofono>
      </modulo>
      <chiacchier chi="risposta" annascuso></chiacchier>
    </core>
    <chiamm da="pezzi/pere.emmurt" />
    <fratm da="/src/main.fratm" />
  </panz>
</cristian>
