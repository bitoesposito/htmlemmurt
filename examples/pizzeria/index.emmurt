<!-- 'A paggena 'e casa -->
<cristian lengua="it">
  <capa>
    <inciucc nomme="viewport" cuntenuto="width=device-width, initial-scale=1">
    <titulo>'A Pizzeria 'e Gennaro</titulo>
    <attacca rapporto="icona" addo="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🍕</text></svg>">
    <attacca rapporto="stile" addo="/stile.css">
  </capa>
  <panz>
    <chiamm da="pezzi/cappiell.emmurt" />
    <core>
      <piezz classe="eroe">
        <luccolone>Uè, trase!</luccolone>
        <chiacchier>'O furno è caldo. Quante pizze sfurnammo oggi?</chiacchier>
        <citofono tipo="buttone" quanno-tuocche="sforna()">Sforna na pizza</citofono>
        <chiacchier>Pizze sfurnate: <fort chi="sfurnate">0</fort></chiacchier>
      </piezz>
    </core>
    <chiamm da="pezzi/pere.emmurt" />
    <fratm>
      tien sfurnate = 0
      facc sforna() {
          sfurnate++
          document.querySelector("#sfurnate").textContent = sfurnate
      }
    </fratm>
    <fratm da="/src/main.fratm" />
  </panz>
</cristian>
