<cristian lengua="it">
  <capa>
    <titulo>Nu modulo</titulo>
  </capa>
  <panz>
    <modulo addo="/ordina" metodo="manna" ricorda="no">
      <recinto>
        <leggenda>Chi si'?</leggenda>
        <targhett pe="nomme">Nomme</targhett>
        <miett chi="nomme" nomme="nomme" tipo="testo" esempio="Gennaro" poffozza subbeto>
        <targhett pe="posta">Posta</targhett>
        <miett chi="posta" nomme="posta" tipo="posta" esempio="gennaro@pizza.it">
        <targhett pe="parola">Parola segreta</targhett>
        <miett chi="parola" nomme="parola" tipo="fattimiei" lunghezzaminima="8">
      </recinto>
      <recinto>
        <leggenda>Che pizza vuò?</leggenda>
        <scegli nomme="pizza">
          <gruppo etichetta="Rosse">
            <scelta valore="margherita" scigliuto>Margherita</scelta>
            <scelta valore="marinara">Marinara</scelta>
          </gruppo>
          <scelta valore="bianca">Bianca</scelta>
        </scegli>
        <targhett><miett tipo="spunta" nomme="bufala" spuntato> Cu 'a bufala</targhett>
        <targhett><miett tipo="pallino" nomme="cottura" valore="normale" spuntato> Normale</targhett>
        <targhett><miett tipo="pallino" nomme="cottura" valore="ben-cotta"> Ben cotta</targhett>
        <targhett pe="quante">Quante?</targhett>
        <miett chi="quante" nomme="quante" tipo="numero" minimo="1" massimo="20" passo="1" valore="1">
        <targhett pe="quanno">Pe' quanno?</targhett>
        <miett chi="quanno" nomme="quanno" tipo="dataeora">
        <miett nomme="tavolo" tipo="annascuso" valore="7">
      </recinto>
      <targhett pe="note">Note</targhett>
      <ragionamento chi="note" nomme="note" righe="3" colonne="40" esempio="Senza aglio, pe' piacere"></ragionamento>
      <avanzamento valore="2" massimo="3">2 'e 3</avanzamento>
      <citofono tipo="manna">Ordina</citofono>
      <citofono tipo="azzera">Accummencia 'a capo</citofono>
      <citofono tipo="buttone" stutato>Nun se pò</citofono>
    </modulo>
  </panz>
</cristian>
