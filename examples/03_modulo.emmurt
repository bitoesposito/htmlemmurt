<cristian lingua="it">
  <capa>
    <titolo>Nu modulo</titolo>
  </capa>
  <panz>
    <modulo addo="/ordina" metodo="manna" ricorda="no">
      <recinto>
        <leggenda>Chi si'?</leggenda>
        <etichetta pe="nomme">Nomme</etichetta>
        <miett chi="nomme" nomme="nomme" tipo="testo" esempio="Gennaro" obbligatorio subbeto>
        <etichetta pe="posta">Posta</etichetta>
        <miett chi="posta" nomme="posta" tipo="posta" esempio="gennaro@pizza.it">
        <etichetta pe="parola">Parola segreta</etichetta>
        <miett chi="parola" nomme="parola" tipo="fattimiei" lunghezzaminima="8">
      </recinto>
      <recinto>
        <leggenda>Che pizza vuò?</leggenda>
        <scegli nomme="pizza">
          <gruppo etichetta="Rosse">
            <opzione valore="margherita" scigliuto>Margherita</opzione>
            <opzione valore="marinara">Marinara</opzione>
          </gruppo>
          <opzione valore="bianca">Bianca</opzione>
        </scegli>
        <etichetta><miett tipo="spunta" nomme="bufala" spuntato> Cu 'a bufala</etichetta>
        <etichetta><miett tipo="pallino" nomme="cottura" valore="normale" spuntato> Normale</etichetta>
        <etichetta><miett tipo="pallino" nomme="cottura" valore="ben-cotta"> Ben cotta</etichetta>
        <etichetta pe="quante">Quante?</etichetta>
        <miett chi="quante" nomme="quante" tipo="numero" minimo="1" massimo="20" passo="1" valore="1">
        <etichetta pe="quanno">Pe' quanno?</etichetta>
        <miett chi="quanno" nomme="quanno" tipo="dataeora">
        <miett nomme="tavolo" tipo="annascuso" valore="7">
      </recinto>
      <etichetta pe="note">Note</etichetta>
      <ragionamento chi="note" nomme="note" righe="3" colonne="40" esempio="Senza aglio, pe' piacere"></ragionamento>
      <avanzamento valore="2" massimo="3">2 'e 3</avanzamento>
      <citofono tipo="manna">Ordina</citofono>
      <citofono tipo="azzera">Accummencia 'a capo</citofono>
      <citofono tipo="buttone" stutato>Nun se pò</citofono>
    </modulo>
  </panz>
</cristian>
