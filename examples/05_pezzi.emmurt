<cristian lengua="it">
  <capa>
    <titulo>Pezzi riusati</titulo>
  </capa>
  <panz>
    <chiamm da="pezzi/cappiell.emmurt" />
    <core>
      <chiacchier>'O cappiell e 'o pere stanno int'a cartella pezzi: ogni paggena 'e chiamma.</chiacchier>
    </core>
    <chiamm da="pezzi/pere.emmurt" />
  </panz>
</cristian>
