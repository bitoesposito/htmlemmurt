<cristian lingua="it">
  <capa>
    <titolo>Testo, liste e link</titolo>
  </capa>
  <panz>
    <cappiell>
      <luccolone>'O vocabolario d'a pizza</luccolone>
    </cappiell>
    <core>
      <fattariello>
        <luccolo>Comme se fa</luccolo>
        <chiacchier>
          Na pizza vera vo' <corsivo>pazienza</corsivo>, <fort>farina bbona</fort>
          e nu furno a legna. <piccirill>'O resto so' chiacchiere.</piccirill>
        </chiacchier>
        <elenco>
          <voce>Impasta</voce>
          <voce>Aspetta <ncoppa>(assaje)</ncoppa></voce>
          <voce>Stienne e condisci</voce>
          <voce>Inforna pe' 90 secondi</voce>
        </elenco>
        <citazione>
          <chiacchier>'A pizza è comme a vita: si 'a faje 'e pressa, s'abbrucia.</chiacchier>
        </citazione>
        <vocabolario>
          <parola>Cornicione</parola>
          <significato>'O bordo auto e cu 'e bolle.</significato>
          <parola>Panetto</parola>
          <significato>'A pallottola 'e pasta primma 'e l'ammaccà.</significato>
        </vocabolario>
        <accussì>
  ()()
 (    )   ← na pizza vista 'a coppa
  ()()
        </accussì>
      </fattariello>
      <allato>
        <chiacchier>
          Leggi 'o
          <vattenn addo="https://it.wikipedia.org/wiki/Pizza_napoletana" arape="nuova">disciplinare</vattenn>.
          <acap>
          <abbreviazione titolo="Specialità tradizionale garantita">STG</abbreviazione> dal
          <tiempo quanno="2010-02-04">2010</tiempo>.
        </chiacchier>
      </allato>
    </core>
    <stacc>
    <pere>
      <chiacchier>Prova <tastiera>Ctrl</tastiera>+<tastiera>S</tastiera> e <codice>emmurt build</codice>.</chiacchier>
    </pere>
  </panz>
</cristian>
