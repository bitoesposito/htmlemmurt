chist è TESTI = { it, en, nap }

facc dalBrowser() {
    chist è dalLink = nu bell URLSearchParams(location.search).get("lang")
    si (LINGUE.includes(dalLink)) {
        piglie dalLink
    }
    pruvamm {
        chist è salvata = localStorage.getItem(CHIAVE)
        si (LINGUE.includes(salvata)) {
            piglie salvata
        }
    } e si schiatta (e) {
        // Senza localStorage se piglia chella d'o browser
    }
    pe ogni (chist è l dint navigator.languages ?? [navigator.language]) {
        chist è base = String(l).toLowerCase().split("-")[0]
        si (base === "nap" || base === "it") {
            piglie base
        }
    }
    piglie "en"
}

tien lingua = dalBrowser()
chist è ascoltatori = []

mann for facc lenguaAttuale() {
    piglie lingua
}

/** 'O testo 'e na chiave, cu {parametri} sostituiti. */
mann for facc t(chiave, parametri = {}) {
    chist è testo = TESTI[lingua][chiave] ?? TESTI.it[chiave] ?? chiave
    piglie testo.replace(/\{(\w+)\}/g, (tutto, nomme) => String(parametri[nomme] ?? tutto))
}

/** Mette 'e testi int'e elementi cu data-t, data-t-aria, data-t-title e data-t-esempio. */
mann for facc traduci(radice = document) {
    pe ogni (chist è el dint radice.querySelectorAll("[data-t]")) {
        el.textContent = t(el.dataset.t)
    }
    pe ogni (chist è el dint radice.querySelectorAll("[data-t-aria]")) {
        el.setAttribute("aria-label", t(el.dataset.tAria))
    }
    pe ogni (chist è el dint radice.querySelectorAll("[data-t-title]")) {
        el.title = t(el.dataset.tTitle, { shortcut: SCORCIATOIA })
    }
    pe ogni (chist è el dint radice.querySelectorAll("[data-t-esempio]")) {
        el.placeholder = t(el.dataset.tEsempio)
    }
}

mann for chist è SCORCIATOIA = /Mac|iPhone|iPad/.test(navigator.platform) ? "⌘↵" : "Ctrl+↵"

mann for facc cagnaLingua(nova) {
    si (!LINGUE.includes(nova) || nova === lingua) {
        piglie
    }
    lingua = nova
    pruvamm {
        localStorage.setItem(CHIAVE, nova)
    } e si schiatta (e) {
        // Vale pe sta visita
    }
    document.documentElement.lang = nova
    traduci()
    pe ogni (chist è f dint ascoltatori) {
        f(nova)
    }
}

/** Chiamma f ogni vota ca cagna 'a lengua. */
mann for facc quannoCagnaLingua(f) {
    ascoltatori.push(f)
}

/** 'E nomme d'e lengue, pe 'o menù: ognuna scritta int'a lengua soja. */
mann for facc nommeLingua(l) {
    piglie TESTI[l]["lang.name"]
}

document.documentElement.lang = lingua
