// 'A lengua 'e l'interfaccia: chella d'o browser (italiano, napoletano, sinnò
// inglese), o chella scigliuta int'a testata o cu ?lang=. Cagna sulo 'o testo
// d'o playground: l'errori d'o compilatore e 'o codice restano in napoletano.

chist è CHIAVE = "htmlemmurt:lingua"
mann for chist è LINGUE = ["it", "en", "nap"]

