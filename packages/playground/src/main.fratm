// 'O playground: htmlemmurt a sinistra, paggena, console e HTML a destra.
// Stesso aspetto e stesse funzioni d'o playground 'e FratmScript, ma scritto
// in htmlemmurt, FratmScript e par-o-css.

chiamm { t, traduci, cagnaLingua, quannoCagnaLingua, lenguaAttuale, nommeLingua, LINGUE } da "./lingua.fratm"
chiamm { mettiIcone, icona } da "./icone.fratm"
chiamm { crea, leggiSalvato, salva } da "./dom.fratm"
chiamm { creaEditor, creaVista, metti, segnala, vaiA, imparaParole } da "./editor.fratm"
chiamm { carica, compila, arrecetta, creaAnteprima, canonico } da "./paggena.fratm"
chiamm { linkPe, codiceDalLink } da "./condividi.fratm"
chiamm { preparaAiuto } da "./aiuto.fratm"
chiamm { LEZIONI, creaScola } da "./scola.fratm"
chiamm { SEZIONI, creaGuida } da "./guida.fratm"
chiamm ue da "../esempi/ue.emmurt?raw"
chiamm sbagliato da "../esempi/sbagliato.emmurt?raw"
chiamm munno da "../../../examples/01_ue_munno.emmurt?raw"
chiamm testo da "../../../examples/02_testo.emmurt?raw"
chiamm modulo da "../../../examples/03_modulo.emmurt?raw"
chiamm conFratm da "../../../examples/04_fratm.emmurt?raw"
chiamm pezzi da "../../../examples/05_pezzi.emmurt?raw"
chiamm tavula da "../../../examples/06_tavula_e_media.emmurt?raw"

chist è ESEMPI = [
    { id: "ue", codice: ue },
    { id: "munno", codice: munno },
    { id: "testo", codice: testo },
    { id: "modulo", codice: modulo },
    { id: "fratm", codice: conFratm },
    { id: "pezzi", codice: pezzi },
    { id: "tavula", codice: tavula },
    { id: "sbagliato", codice: sbagliato },
]

chist è SALVATO = "htmlemmurt:codice"
chist è AUTOMATICO = "htmlemmurt:automatico"
chist è TEMA = "htmlemmurt:tema"
chist è CODICE_LEZIONE = "htmlemmurt:scola:"
chist è FATTE = "htmlemmurt:scola:fatte"
chist è ATTESA_MS = 700

chist è pesca = (chi) => document.getElementById(chi)
chist è tutti = (selettore) => [...document.querySelectorAll(selettore)]

// ---------- Stato

tien codice = ""
tien ultimoLanciato = nisciun
tien pronto = sfòls
tien automatico = leggiSalvato(AUTOMATICO) !== "false"
tien esempio = ""
tien lezione = nisciun
tien sezione = nisciun
tien scheda = "codice"
tien attesa = nisciun
tien soluzioni = nu bell Map()
tien fatte = nu bell Set()
pruvamm {
    fatte = nu bell Set(JSON.parse(leggiSalvato(FATTE) ?? "[]"))
} e si schiatta (e) {
    // Nu salvataggio rotto: se ricomincia
}

// ---------- Testata: lengua e tema

pe ogni (chist è scegli dint tutti(".scegli-lingua")) {
    scegli.append(...LINGUE.map((l) => nu bell Option(nommeLingua(l), l)))
    scegli.value = lenguaAttuale()
    scegli.addEventListener("change", (evento) => cagnaLingua(evento.target.value))
}

chist è scuroD_oSistema = matchMedia("(prefers-color-scheme: dark)")

facc applicaTema() {
    chist è scelta = leggiSalvato(TEMA) ?? "sistema"
    chist è scuro = scelta === "scuro" || (scelta === "sistema" && scuroD_oSistema.matches)
    document.documentElement.dataset.tema = scuro ? "scuro" : "chiaro"
    pe ogni (chist è scegli dint tutti(".scegli-tema")) {
        scegli.value = scelta
    }
}

facc scriviTemi() {
    pe ogni (chist è scegli dint tutti(".scegli-tema")) {
        scegli.replaceChildren(
            nu bell Option(t("theme.system"), "sistema"),
            nu bell Option(t("theme.light"), "chiaro"),
            nu bell Option(t("theme.dark"), "scuro"),
        )
    }
    applicaTema()
}

pe ogni (chist è scegli dint tutti(".scegli-tema")) {
    scegli.addEventListener("change", (evento) => {
        salva(TEMA, evento.target.value)
        applicaTema()
    })
}
scuroD_oSistema.addEventListener("change", applicaTema)

// ---------- Avvisi, comme 'e toast 'e FratmScript

tien avvisoTimer = nisciun

facc avvisa(titolo, descrizione) {
    chist è avviso = pesca("avviso")
    avviso.replaceChildren(crea("strong", "blocco scrittura-peso-500", titolo), crea("span", "blocco margine-ncoppa-0.5 culore-scritta-smorta", descrizione))
    avviso.hidden = sfòls
    clearTimeout(avvisoTimer)
    avvisoTimer = setTimeout(() => {
        avviso.hidden = overo
    }, 4000)
}

// ---------- Barra 'e stato

facc stato(tipo, testo, tiempo = "") {
    chist è pallino = pesca("stato-pallino")
    chist è culore = { pronto: "sfunno-buono", sbaglio: "sfunno-sbaglio", attesa: "sfunno-attesa", carica: "sfunno-attesa pulsa" }[tipo]
    pallino.className = `pallino ${culore}`
    // Pe chi prova 'o playground (e2e), senza dipendere d'a lengua
    pesca("barra-stato").dataset.stato = tipo
    chist è scritta = pesca("stato-testo")
    // Sulo quanno cagna, accussì 'o lettore 'e schermo nun 'o ripete a ogni tasto
    si (scritta.textContent !== testo) {
        scritta.textContent = testo
    }
    pesca("tiempo").textContent = tiempo
    pesca("tiempo").hidden = !tiempo
    pesca("tiempo-filo").hidden = !tiempo
}

tien ultimoStato = () => stato("carica", t("status.loading"))

// ---------- Risultato: anteprima, errori, console, HTML

chist è anteprima = creaAnteprima(pesca("anteprima"), (tipo, testo) => scriviConsole(tipo, testo))
chist è vistaHtml = creaVista({ parent: pesca("html"), etichetta: t("output.html") })

facc contaConsole() {
    chist è voci = pesca("console").children.length
    chist è sbagli = pesca("sbagli").children.length + tutti("#console [data-tipo=error]").length
    pesca("console").hidden = voci === 0
    pesca("console-vacante").hidden = voci > 0
    chist è contatore = document.querySelector("[data-contatore]")
    chist è quante = sbagli > 0 ? sbagli : voci
    contatore.hidden = quante === 0
    contatore.toggleAttribute("data-sbagli", sbagli > 0)
    contatore.textContent = quante > 99 ? "99+" : String(quante)
    contatore.setAttribute("aria-label", t(sbagli > 0 ? "tabs.errors" : "tabs.messages", { n: quante }))
}

facc scriviConsole(tipo, testo) {
    chist è voce = crea("li", "voce-console")
    voce.dataset.tipo = tipo
    chist è segno = crea("span", "flessibile margine-ncoppa-0.5 [flex-shrink:0] culore-scritta-smorta")
    segno.innerHTML = icona(tipo === "error" ? "sbaglio" : tipo === "warn" ? "attenzione" : "destra")
    voce.append(segno, crea("span", "cresce", testo))
    pesca("console").append(voce)
    contaConsole()
}

facc cartaSbaglio(e) {
    chist è carta = crea("div", "spazio-3 bordo bordo-sbaglio/20 bordo-tunno-lg sfunno-sbaglio/5 scrittura-grannezza-sm")
    chist è capo = crea("div", "flessibile a-capo allinea-cose-miezo giustifica-spartuto spazio-mmiez-2")
    capo.append(crea("strong", "scrittura-peso-500 culore-sbaglio-scritta", t("error.compile")))
    chist è dove = crea("button", "buttone buttone-fantasma buttone-piccolo culore-sbaglio-scritta", t("output.lineColumn", { line: e.line, column: e.column }))
    dove.type = "button"
    dove.addEventListener("click", () => {
        mostraScheda("codice")
        requestAnimationFrame(() => vaiA(editor, e.line, e.column))
    })
    capo.append(dove)
    carta.append(capo, crea("p", "margine-ncoppa-1 scrittura-mono [white-space:pre-wrap]", e.suggestion ? `${e.message}\n${e.suggestion}` : e.message))
    piglie carta
}

facc vecchio(si_) {
    pe ogni (chist è vista dint [pesca("anteprima"), pesca("html")]) {
        vista.classList.toggle("opacità-60", si_)
    }
}

/** Compila e fa vedé. `daBottone`: l'ha chiesto chi scrive (Esegui, Ctrl+Invio). */
facc lancia(daBottone = sfòls) {
    si (!pronto) {
        piglie
    }
    clearTimeout(attesa)
    chist è { html, sbagli, ms } = compila(codice)
    ultimoLanciato = codice
    chist è e = sbagli[0]
    segnala(editor, e)
    pesca("sbagli").replaceChildren(...sbagli.map(cartaSbaglio))
    si (e) {
        // Anteprima e HTML restano chilli 'e primma: se vede ca so' viecchie
        vecchio(overo)
        ultimoStato = () => stato("sbaglio", t("status.compileError"))
    } sinnò {
        vecchio(sfòls)
        pesca("console").replaceChildren()
        anteprima.mostra(html)
        metti(vistaHtml, html)
        chist è tiempo = ms.toFixed(1)
        ultimoStato = () => stato("pronto", t("status.done"), t("status.compiledIn", { ms: tiempo }))
        controllaLezione(html)
    }
    ultimoStato()
    contaConsole()
    // Ncopp'o telefono 'o risultato sta int'a scheda soja: Esegui l'apre
    si (daBottone && scheda === "codice" && telefono.matches) {
        mostraScheda(e ? "console" : "anteprima")
    }
}

// ---------- L'editor

facc nomeFile() {
    si (lezione !== nisciun) {
        piglie `scola/${LEZIONI[lezione].id}.emmurt`
    }
    piglie esempio && esempio !== "proprio" ? `${esempio}.emmurt` : "index.emmurt"
}

facc scriviEsempi() {
    chist è scegli = pesca("esempi")
    scegli.replaceChildren(nu bell Option(t("editor.chooseExample"), ""))
    si (esempio === "proprio") {
        chist è proprio = nu bell Option(t("editor.custom"), "proprio")
        proprio.disabled = overo
        scegli.append(proprio)
    }
    scegli.append(...ESEMPI.map((x) => nu bell Option(t(`ex.${x.id}`), x.id)))
    scegli.value = esempio
    pesca("file").textContent = nomeFile()
    pesca("cagnato").hidden = esempio !== "proprio"
}

facc quannoCagna(nuovo) {
    codice = nuovo
    // Cagnà n'esempio 'o fa diventà codice tuoio
    si (esempio && esempio !== "proprio" && ESEMPI.find((x) => x.id === esempio)?.codice !== nuovo) {
        esempio = "proprio"
        scriviEsempi()
    }
    // 'O codice cagnato nun è cchiù chillo d'o link: 'o salvataggio vale 'e cchiù
    si (location.hash.startsWith("#codice=")) {
        history.replaceState(nisciun, "", location.pathname + location.search)
    }
    salva(lezione === nisciun ? SALVATO : CODICE_LEZIONE + LEZIONI[lezione].id, nuovo)
    si (!pronto) {
        piglie
    }
    clearTimeout(attesa)
    vecchio(nuovo !== ultimoLanciato)
    si (automatico) {
        ultimoStato = () => stato("attesa", t("status.staleAuto"))
        attesa = setTimeout(lancia, ATTESA_MS)
    } sinnò {
        ultimoStato = () => stato("attesa", t("status.staleManual"))
    }
    ultimoStato()
}

facc arrecettaCodice() {
    si (!pronto) {
        piglie
    }
    chist è arrecettato = arrecetta(codice)
    si (arrecettato !== nisciun && arrecettato !== codice) {
        metti(editor, arrecettato)
    }
}

chist è editor = creaEditor({
    parent: pesca("editor"),
    etichetta: t("editor.label"),
    quannoCagna,
    lancia: () => lancia(overo),
    arrecetta: arrecettaCodice,
})

facc mettiCodice(nuovo) {
    metti(editor, nuovo)
    codice = nuovo
}

// ---------- Schede ncopp'o telefono

chist è telefono = matchMedia("(max-width: 767px)")

facc mostraScheda(nova) {
    scheda = nova
    pe ogni (chist è s dint tutti("[data-scheda]")) {
        s.setAttribute("aria-selected", String(s.dataset.scheda === nova))
    }
    chist è piccolo = telefono.matches
    pesca("pannello-codice").hidden = piccolo && nova !== "codice"
    pesca("pannello-uscita").hidden = piccolo && nova === "codice"
    pe ogni (chist è piezz dint tutti("[data-sezione]")) {
        piezz.hidden = piccolo && nova !== "codice" && piezz.dataset.sezione !== nova
        piezz.toggleAttribute("data-sola", piccolo && piezz.dataset.sezione === nova)
    }
    vistaHtml.requestMeasure()
}

pe ogni (chist è s dint tutti("[data-scheda]")) {
    s.addEventListener("click", () => mostraScheda(s.dataset.scheda))
}
telefono.addEventListener("change", () => mostraScheda(scheda))

// ---------- Scola

chist è scola = creaScola({
    vai: (i) => apriLezione(i),
    esci: () => esciDaScola(),
    metti: mettiCodice,
})

facc controllaLezione(html) {
    si (lezione === nisciun) {
        piglie
    }
    chist è l = LEZIONI[lezione]
    si (fatte.has(l.id)) {
        piglie
    }
    si (!soluzioni.has(l.id)) {
        soluzioni.set(l.id, canonico(compila(l.soluzione).html ?? ""))
    }
    si (canonico(html) === soluzioni.get(l.id)) {
        fatte.add(l.id)
        salva(FATTE, JSON.stringify([...fatte]))
        scola.mostra(lezione, fatte)
    }
}

facc apriLezione(i) {
    chist è indice = Math.min(Math.max(i, 0), LEZIONI.length - 1)
    si (sezione !== nisciun) {
        esciDaGuida()
    }
    lezione = indice
    esempio = ""
    pesca("impara").setAttribute("aria-pressed", "true")
    pesca("impara").title = t("header.tourExit")
    pesca("esempi-barra").hidden = overo
    scola.mostra(indice, fatte)
    chist è l = LEZIONI[indice]
    mettiCodice(leggiSalvato(CODICE_LEZIONE + l.id) ?? l.partenza)
    scriviEsempi()
    mostraScheda("codice")
    history.replaceState(nisciun, "", `#scola=${indice + 1}`)
    lancia()
}

facc esciDaScola() {
    lezione = nisciun
    scola.nasconde()
    pesca("impara").setAttribute("aria-pressed", "false")
    pesca("impara").title = t("header.tourOpen")
    pesca("esempi-barra").hidden = sfòls
    mettiCodice(leggiSalvato(SALVATO) ?? ue)
    scriviEsempi()
    history.replaceState(nisciun, "", location.pathname + location.search)
    lancia()
}

pesca("impara").addEventListener("click", () => {
    si (lezione !== nisciun) {
        esciDaScola()
        piglie
    }
    // Se ripiglia d'a primma lezione ca nun è fatta ancora
    chist è prossima = LEZIONI.findIndex((l) => !fatte.has(l.id))
    apriLezione(prossima === -1 ? 0 : prossima)
})

// ---------- Guida

chist è guida = creaGuida({
    vai: (i) => apriGuida(i),
    apri: (nuovo) => {
        esciDaGuida()
        esempio = "proprio"
        mettiCodice(nuovo)
        scriviEsempi()
        mostraScheda("codice")
        lancia()
    },
})

facc mostraGuida(si_) {
    pesca("banco").hidden = si_
    pesca("schede").hidden = si_
    pesca("barra-stato").hidden = si_
    pesca("azioni").hidden = si_
    chist è link = pesca("guida")
    link.href = si_ ? location.pathname + location.search : "#guida"
    link.querySelector("[data-t]").dataset.t = si_ ? "header.playground" : "header.guide"
    link.dataset.tAria = si_ ? "header.guideExit" : "header.guideLabel"
    link.dataset.tTitle = si_ ? "header.guideExit" : "header.guideOpen"
    link.querySelector("svg").outerHTML = icona(si_ ? "terminale" : "libro")
    traduci(link.parentElement)
}

facc apriGuida(i) {
    si (lezione !== nisciun) {
        esciDaScola()
    }
    sezione = Math.min(Math.max(i, 0), SEZIONI.length - 1)
    mostraGuida(overo)
    guida.mostra(sezione)
    history.replaceState(nisciun, "", `#guida=${SEZIONI[sezione].id}`)
}

facc esciDaGuida() {
    sezione = nisciun
    guida.nasconde()
    mostraGuida(sfòls)
    history.replaceState(nisciun, "", location.pathname + location.search)
    mostraScheda(scheda)
}

pesca("guida").addEventListener("click", (evento) => {
    // Nu click cu Ctrl o 'a rotella apre 'a guida n'ata scheda, comme nu link
    si (evento.button !== 0 || evento.metaKey || evento.ctrlKey || evento.shiftKey || evento.altKey) {
        piglie
    }
    evento.preventDefault()
    si (sezione !== nisciun) {
        esciDaGuida()
    } sinnò {
        apriGuida(0)
    }
})

// ---------- Bottoni e menù

pesca("esegui").addEventListener("click", () => lancia(overo))
pesca("formatta").addEventListener("click", arrecettaCodice)
pesca("pulizza").addEventListener("click", () => {
    pesca("console").replaceChildren()
    contaConsole()
})

chist è automaticoSpunta = pesca("automatico")
automaticoSpunta.checked = automatico
automaticoSpunta.addEventListener("change", () => {
    automatico = automaticoSpunta.checked
    salva(AUTOMATICO, String(automatico))
    si (automatico && codice !== ultimoLanciato) {
        lancia()
    }
})

pesca("esempi").addEventListener("change", (evento) => {
    chist è scigliuto = ESEMPI.find((x) => x.id === evento.target.value)
    si (!scigliuto) {
        piglie
    }
    esempio = scigliuto.id
    mettiCodice(scigliuto.codice)
    scriviEsempi()
    lancia()
})

pesca("condividi").addEventListener("click", mo vir () => {
    chist è link = aspett linkPe(codice)
    history.replaceState(nisciun, "", link)
    pruvamm {
        aspett navigator.clipboard.writeText(link)
        avvisa(t("share.copied"), t("share.copiedDesc"))
    } e si schiatta (e) {
        avvisa(t("share.failed"), link)
    }
})

pesca("copia-html").addEventListener("click", mo vir () => {
    chist è scritta = pesca("copia-html").querySelector("[data-t]")
    pruvamm {
        aspett navigator.clipboard.writeText(vistaHtml.state.doc.toString())
        scritta.textContent = t("output.copied")
    } e si schiatta (e) {
        scritta.textContent = t("share.failed")
    }
    setTimeout(() => {
        scritta.textContent = t("output.copyHtml")
    }, 2000)
})

quannoCagnaLingua(() => {
    scriviTemi()
    scriviEsempi()
    ultimoStato()
    contaConsole()
    si (lezione !== nisciun) {
        scola.scrivi()
    }
    si (sezione !== nisciun) {
        mostraGuida(overo)
        guida.scrivi()
    }
})

// ---------- Si parte

mettiIcone()
traduci()
scriviTemi()
scriviEsempi()
mostraScheda("codice")
contaConsole()
ultimoStato()

chist è dalHash = nu bell URLSearchParams(location.hash.slice(1))
chist è dalLink = aspett codiceDalLink()
mettiCodice(dalLink ?? leggiSalvato(SALVATO) ?? ue)
si (!dalLink) {
    // Nu codice salvato ca è ancora n'esempio se tene 'o nomme suojo
    esempio = codice === ue ? "" : ESEMPI.find((x) => x.codice === codice)?.id ?? "proprio"
    scriviEsempi()
}

pruvamm {
    chist è { versione, vocabolario } = aspett carica()
    pesca("versione").textContent = versione
    imparaParole(vocabolario)
    preparaAiuto(vocabolario)
    pronto = overo
    pe ogni (chist è b dint [pesca("esegui"), pesca("formatta")]) {
        b.disabled = sfòls
    }
    pesca("carica").hidden = overo
    ultimoStato = () => stato("pronto", t("status.ready"))
    si (dalHash.has("scola")) {
        apriLezione(Number.parseInt(dalHash.get("scola"), 10) - 1 || 0)
    } sinnò si (dalHash.has("guida")) {
        apriGuida(Math.max(SEZIONI.findIndex((s) => s.id === dalHash.get("guida")), 0))
        lancia()
    } sinnò {
        lancia()
    }
} e si schiatta (e) {
    pesca("carica").replaceChildren(crea("strong", "blocco scrittura-peso-600 culore-sbaglio-scritta", t("error.load")), crea("span", "blocco margine-ncoppa-1 larghezza-massima-md allinea-testo-miezo", t("error.loadMessage")))
    pesca("carica").classList.add("direzione-colonna")
    ultimoStato = () => stato("sbaglio", t("status.loadFailed"))
    ultimoStato()
    iett e
}
