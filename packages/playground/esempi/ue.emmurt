<cristian lingua="it">
  <capa>
    <titolo>Uè!</titolo>
    <cess>
      panz { scrittura: system-ui, sans-serif; allinea-testo: miezo; spazio: 2rem; }
      citofono { font: ereditato; spazio: .5rem 1.2rem; cursore: manella; }
    </cess>
  </capa>
  <panz>
    <luccolone>Uè, frà!</luccolone>
    <chiacchier>Chest è HTML, ma scritto <guapp>comme si deve</guapp>.</chiacchier>
    <citofono tipo="buttone" quanno-tuocche="sona()">Citofona</citofono>
    <chiacchier chi="risposta"></chiacchier>
    <fratm>
      tien vote = 0
      facc sona() {
          vote++
          stamm a dì("Driiin!", vote)
          document.querySelector("#risposta").textContent =
              vote == 1 ? "Chi è?" : `N'ata vota? So' ${vote} vote!`
      }
    </fratm>
  </panz>
</cristian>
