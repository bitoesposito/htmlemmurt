{
  "Cristian": {
    "prefix": [
      "cristian",
      "!"
    ],
    "description": "Na paggena sana",
    "body": [
      "<cristian lingua=\"${1:it}\">",
      "  <capa>",
      "    <inciucc nomme=\"viewport\" cuntenuto=\"width=device-width, initial-scale=1\">",
      "    <titolo>${2:Titolo}</titolo>",
      "  </capa>",
      "  <panz>",
      "    $0",
      "  </panz>",
      "</cristian>"
    ]
  },
  "FratmScript": {
    "prefix": "fratm",
    "description": "Nu blocco 'e FratmScript",
    "body": [
      "<fratm>",
      "  $0",
      "</fratm>"
    ]
  },
  "FratmScript da file": {
    "prefix": "fratmda",
    "description": "FratmScript pigliato 'a nu file",
    "body": [
      "<fratm da=\"${1:/src/main.fratm}\" />"
    ]
  },
  "Chiamm": {
    "prefix": "chiamm",
    "description": "Ncolla n'atu file .emmurt",
    "body": [
      "<chiamm da=\"${1:pezzi/menu.emmurt}\" />"
    ]
  },
  "Citofono": {
    "prefix": "citofono",
    "description": "Nu citofono (buttone) cu nu quanno-tuocche",
    "body": [
      "<citofono tipo=\"buttone\" quanno-tuocche=\"${1:sforna()}\">${2:Sforna}</citofono>"
    ]
  },
  "List": {
    "prefix": "list",
    "description": "Na lista cu na voce",
    "body": [
      "<list>",
      "  <voce>$0</voce>",
      "</list>"
    ]
  },
  "Modulo": {
    "prefix": "modulo",
    "description": "Nu modulo cu nu miett",
    "body": [
      "<modulo addo=\"${1:/manna}\" metodo=\"manna\">",
      "  <etichetta pe=\"${2:nomme}\">${3:Nomme}</etichetta>",
      "  <miett chi=\"$2\" nomme=\"$2\" tipo=\"testo\">",
      "  <citofono tipo=\"manna\">${4:Manna}</citofono>",
      "</modulo>"
    ]
  }
}
