{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "htmlemmurt",
  "scopeName": "text.html.emmurt",
  "fileTypes": ["emmurt"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#fratm" },
    { "include": "#cess" },
    { "include": "#chiamm" },
    { "include": "#tag" },
    { "include": "#entity" }
  ],
  "repository": {
    "comment": {
      "name": "comment.block.html",
      "begin": "<!--",
      "end": "-->",
      "captures": { "0": { "name": "punctuation.definition.comment.html" } }
    },
    "entity": {
      "name": "constant.character.entity.html",
      "match": "&(?:[a-zA-Z][a-zA-Z0-9]*|#[0-9]+|#x[0-9a-fA-F]+);"
    },
    "fratm": {
      "comment": "<fratm>…</fratm>: FratmScript, with JavaScript colours when the FratmScript extension is missing. A self-closing <fratm da=\"…\" /> is a plain tag.",
      "begin": "(?i)(<)(fratm)\\b(?![^>]*/>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" }
      },
      "end": "(?i)(</)(fratm)\\s*(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "#start-tag-rest" },
        {
          "begin": "(?<=>)",
          "end": "(?i)(?=</fratm\\s*>)",
          "contentName": "meta.embedded.block.fratm source.fratm",
          "patterns": [{ "include": "source.fratm" }, { "include": "source.js" }]
        }
      ]
    },
    "cess": {
      "begin": "(?i)(<)(cess)\\b(?![^>]*/>)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" }
      },
      "end": "(?i)(</)(cess)\\s*(>)",
      "endCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" },
        "3": { "name": "punctuation.definition.tag.end.html" }
      },
      "patterns": [
        { "include": "#start-tag-rest" },
        {
          "begin": "(?<=>)",
          "end": "(?i)(?=</cess\\s*>)",
          "contentName": "meta.embedded.block.css source.css",
          "patterns": [{ "include": "source.css" }]
        }
      ]
    },
    "start-tag-rest": {
      "begin": "\\G",
      "end": ">",
      "endCaptures": { "0": { "name": "punctuation.definition.tag.end.html" } },
      "patterns": [{ "include": "#attribute" }]
    },
    "chiamm": {
      "name": "meta.tag.include.emmurt",
      "begin": "(?i)(<)(chiamm)\\b",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "keyword.control.import.emmurt" }
      },
      "end": "/?>",
      "endCaptures": { "0": { "name": "punctuation.definition.tag.end.html" } },
      "patterns": [{ "include": "#attribute" }]
    },
    "tag": {
      "name": "meta.tag.html",
      "begin": "(</?)([\\p{L}][\\p{L}\\p{N}_\\-]*)",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.tag.begin.html" },
        "2": { "name": "entity.name.tag.html" }
      },
      "end": "/?>",
      "endCaptures": { "0": { "name": "punctuation.definition.tag.end.html" } },
      "patterns": [{ "include": "#attribute" }]
    },
    "attribute": {
      "patterns": [
        {
          "comment": "quanno-* handlers hold FratmScript",
          "begin": "(quanno-[\\p{L}\\-]+)\\s*(=)\\s*(\")",
          "beginCaptures": {
            "1": { "name": "entity.other.attribute-name.event.html" },
            "2": { "name": "punctuation.separator.key-value.html" },
            "3": { "name": "punctuation.definition.string.begin.html" }
          },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.html" } },
          "contentName": "meta.embedded.line.fratm source.fratm",
          "patterns": [{ "include": "source.fratm" }, { "include": "source.js" }]
        },
        { "name": "entity.other.attribute-name.html", "match": "[^\\s\"'<>/=]+" },
        { "name": "punctuation.separator.key-value.html", "match": "=" },
        {
          "name": "string.quoted.double.html",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#entity" }]
        },
        {
          "name": "string.quoted.single.html",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#entity" }]
        }
      ]
    }
  }
}
